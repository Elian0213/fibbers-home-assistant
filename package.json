{
  "name": "fibbers",
  "version": "0.9.0",
  "private": true,
  "description": "A bottom-nav dashboard plugin for Home Assistant: a viewport-pinned bottom bar, modal sheets, self-computing room tiles, and dark theming. Lit + Tailwind web components, bundled to a single file.",
  "homepage": "https://elian0213.github.io/fibbers-home-assistant/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Elian0213/fibbers-home-assistant.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run gen-tw && vite build",
    "watch": "bun run gen-tw && vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:stories": "cd storybook && npm run test-storybook:ci",
    "gen-icons": "bun scripts/gen-icons.mjs",
    "gen-tw": "bun scripts/gen-tw.mjs",
    "format": "prettier --write \"src/**/*.{js,ts}\" \"docs/*.html\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "prettier --check \"src/**/*.{js,ts}\" \"docs/*.html\" && bun run typecheck && bun run lint && bun test src && bun run build && bun scripts/check-icons.mjs && bun scripts/check-i18n.mjs && node -e \"new Function(require('fs').readFileSync('dist/fibbers.js','utf8'))\""
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@iconify-json/solar": "1.2.10",
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "^1.4.1",
    "custom-card-helpers": "^2.0.0",
    "eslint": "^9",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.4",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.12.0",
    "prettier": "^3",
    "tailwindcss": "4.3.3",
    "typescript": "6",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@lit-labs/signals": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "lit": "^3.3.3"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
